# --- GitLab (gitlab.com or self-hosted) ---------------------------------------
GITLAB_TOKEN=your_read_only_gitlab_token
GITLAB_BASE_URL=https://gitlab.com
# Project used by `python -m repomentor index` when --project is omitted
GITLAB_PROJECT_PATH=your-username/your-project

# --- GitHub (optional; public repositories work without a token) --------------
# GITHUB_TOKEN=github_pat_...
# GITHUB_API_URL=https://api.github.com
# GITHUB_WEB_URL=https://github.com

# --- Language models (Ollama) ------------------------------------------------
OLLAMA_MODEL=qwen3:1.7b
# OLLAMA_URL=http://localhost:11434
# Optional: a larger model for the coder and reviewer agents
# OLLAMA_CODER_MODEL=qwen2.5-coder:7b
# OLLAMA_CODER_CONTEXT=16384
# Optional: the model that judges answers in evaluation
# OLLAMA_JUDGE_MODEL=qwen3:1.7b

# --- Retrieval ---------------------------------------------------------------
# semantic | bm25 | hybrid | expanded-hybrid | auto
# RETRIEVAL_METHOD=auto
# Cross-encoder that reranks the best candidates (off when empty)
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# auto | tree-sitter | markdown | lines
# CHUNKER=auto
# Refuse questions whose best match is below this similarity (0 disables)
# MIN_RELEVANCE=0.2

# --- Storage -----------------------------------------------------------------
# REPOMENTOR_DATA=data
# VECTOR_STORE=pgvector
# DATABASE_URL=postgresql://repomentor:repomentor@localhost:5432/repomentor

# --- Synchronization ---------------------------------------------------------
# Secrets for push webhooks that keep indexes up to date
# GITLAB_WEBHOOK_SECRET=change-me
# GITHUB_WEBHOOK_SECRET=change-me

# --- Multi-user deployment ---------------------------------------------------
# "token": users sign in with their own GitLab/GitHub token and only see
# repositories that token can read
# AUTH_MODE=none
# Let the coder agent open merge requests (needs a token with write access:
# the signed-in user's, or one of these)
# ALLOW_MERGE_REQUESTS=false
# GITLAB_WRITE_TOKEN=
# GITHUB_WRITE_TOKEN=
